// RevCoop.exe's icon (tools/make_relay_icon.py) and version information (Properties > Details).
// Virus scanners' heuristics count an exe without them against it.
#include <winver.h>

1 ICON "revcoop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,1,0
 PRODUCTVERSION 0,6,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RevNet (Deus Ex: Revision Co-op)"
            VALUE "FileDescription", "Revision Co-op launcher (Steam lobby and relay)"
            VALUE "FileVersion", "0.6.1"
            VALUE "InternalName", "RevCoop"
            VALUE "LegalCopyright", "MIT License; relay based on HXCoop (deus-ex-coop)"
            VALUE "OriginalFilename", "RevCoop.exe"
            VALUE "ProductName", "Revision Co-op (RevNet)"
            VALUE "ProductVersion", "0.6.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
